# Node can load a copied .env with: node --env-file=.env server.js
PORT=3000
# Use development locally. Set production only after configuring real secrets and HTTPS.
NODE_ENV=development
TP_DATA_DIR=storage
TP_BACKUP_DIR=storage/backups
TP_AUTO_BACKUP=1
PUBLIC_SITE_URL=http://localhost:3000
COOKIE_SECURE=0
TRUST_PROXY=0
# Required on the first production boot; use a unique password with 12+ characters.
ADMIN_INITIAL_PASSWORD=
# Configure in the admin UI or here. No mail is sent without these settings.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Maps: public searches use saved coordinates; address lookup runs only on staff click.
GEOCODER_URL=https://photon.komoot.io/api/
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=© OpenStreetMap contributors
